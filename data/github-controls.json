  "controls": [
    {
      "sourceId": "OSPS-BR-01.01",
      "appliesWhen": "untrusted metadata enters CI",
      "proposedControl": "Validate and quote inputs before shell or API use",
      "owner": "red-cup-engineering",
      "verification": "Inspect actual workflow at current SHA and execute a negative-input assay",
      "status": "not-verified"
    },
    {
      "sourceId": "OSPS-BR-01.03",
      "appliesWhen": "CI executes untrusted code snapshots",
      "proposedControl": "No privileged credentials or mutable production assets available to unreviewed code",
      "owner": "red-cup-engineering",
      "verification": "Check job/event/token permissions and exercise a fork-PR negative control",
      "status": "not-verified"
    },
    {
      "sourceId": "OSPS-AC-04.01",
      "appliesWhen": "code project at OSPS maturity level 2 or above",
      "proposedControl": "Set the lowest default CI permission at organization/repository where supported",
      "owner": "561-group",
      "verification": "Read back enabled default workflow permissions",
      "status": "unknown-platform-settings"
    },
    {
      "sourceId": "OSPS-QA-06.01",
      "appliesWhen": "code project at OSPS maturity level 2 or above",
      "proposedControl": "Run applicable automated test suite before protected merge",
      "owner": "red-cup-engineering",
      "verification": "Verified actual test job AND effective required check",
      "status": "not-verified"
    },
    {
      "sourceId": "OSPS-VM-01.01",
      "appliesWhen": "applicable project requires a coordinated disclosure policy",
      "proposedControl": "Publish usable vulnerability disclosure policy and response expectations",
      "owner": "561-group",
      "verification": "Read affected repository's effective SECURITY.md and response process",
      "status": "partial-source-only"
    },
    {
      "sourceId": "OSPS-VM-03.01",
      "appliesWhen": "applicable project must receive vulnerabilities privately",
      "proposedControl": "Offer private vulnerability reports or a verified private contact",
      "owner": "561-group",
      "verification": "Exercise affected repo private reporting route without publishing sensitive data",
      "status": "unknown-platform-settings"
    },
    {
      "sourceId": "OSPS-BR-07.01",
      "appliesWhen": "any project uses version control",
      "proposedControl": "Prevent accidental secrets in source",
      "owner": "red-cup-engineering",
      "verification": "Read enabled scanning/prevention controls, test non-sensitive canary",
      "status": "unknown-platform-settings"
    }
  ],
